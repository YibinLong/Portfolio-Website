---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Yibin Long</h1>
			<p>
				I’m a software developer. This is a simple log of writings, notes, and links I find
				interesting. Mostly programming, sometimes product, occasionally life.
			</p>
			<p>
				Recent posts:
			</p>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.slug || post.id}/`}>{post.data.title}</a>
						<span> — <FormattedDate date={post.data.pubDate} /></span>
					</li>
				))}
			</ul>
			<p>
				View <a href="/blog/">archive</a> for more.
			</p>
		</main>
		<Footer />
	</body>
</html>
