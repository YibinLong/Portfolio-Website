---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<p>
				Hey! My name is Yibin.
			</p>
			<p>
				I'm an AI-First Engineer.<br>
				
				I believe that AI will <a href="https://a16z.com/why-software-is-eating-the-world/" target="_blank">eat the world</a>.<br>
				
				It's a mistake to take it any less seriously. 
			</p>
			<p>
				I live in Canada now, and I was on the East Coast for most of my life before that. Outside of tech, you'll probably find me working out, grappling, or at a board game cafe. I'm a big fan of Lanzhou hand-pulled noodles and classic smashburgers!
			</p>
			<p>
				This is a simple log of my writings and notes.<br>
				Mostly software, occasionally life.
			</p>
			<p>
				Recent Posts:
			</p>
			<ul>
				{posts.map((post) => {
					// Strip date prefix from filename for cleaner URLs
					const cleanSlug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '');
					return (
						<li>
							<a href={`/blog/${cleanSlug}/`}>{post.data.title}</a>
							<span> — <FormattedDate date={post.data.pubDate} /></span>
						</li>
					);
				})}
			</ul>
		</main>
	</body>
</html>
